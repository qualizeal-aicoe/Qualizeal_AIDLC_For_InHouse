{
 "version": 1,
 "about": "Rules for the QZ prompt router. A prompt is matched against each route's words (regular expressions, case-insensitive unless case is true); the route with most weighted hits wins. Words in 'up' raise the tier one step, words in 'down' lower it one step; a route's floor is the lowest tier it may fall to. Tiers map to a model and effort. No model is called to decide.",
 "tiers": {
  "light": {
   "model": "haiku",
   "effort": "low",
   "for": "look-ups, e-mails, minutes, formatting, status updates"
  },
  "standard": {
   "model": "sonnet",
   "effort": "medium",
   "for": "decks, plans, documents, tests, routine code"
  },
  "heavy": {
   "model": "opus",
   "effort": "medium",
   "for": "features across files, debugging, refactors"
  },
  "deep": {
   "model": "opus",
   "effort": "high",
   "for": "architecture, security, reviews, bids, production bugs"
  }
 },
 "ladder": [
  "light",
  "standard",
  "heavy",
  "deep"
 ],
