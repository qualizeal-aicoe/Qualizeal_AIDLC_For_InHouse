   "from": "search",
   "to": "store",
   "label": "full-text match"
  },
  {
   "id": "f12",
   "from": "search",
   "to": "vectors",
   "label": "nearest passages"
  },
  {
   "id": "f13",
   "from": "agent",
   "to": "llm",
   "label": "passages + question"
  },
  {
   "id": "f14",
   "from": "gw",
   "to": "page",
   "label": "answer with sources"
  },
  {
   "id": "f15",
   "from": "gw",
   "to": "logs",
   "label": "request id, status"
  }
 ],
 "steps": [
  {
   "title": "Knowledge comes in",
   "caption": "Connectors read Jira issues and GitHub files. Their tokens come from the environment, never from a file.",
   "flows": [
    "f1",
    "f2"
   ]
  },
  {
   "title": "Screened, labelled, stored",
   "caption": "Each passage is checked for text that gives orders, labelled with who may read it, and stored as text and as a vector.",
   "flows": [
    "f3",
    "f4",
    "f5"
   ]
  },
  {
   "title": "A person asks",
   "caption": "The page sends the question with a short-lived token. The gateway checks its signature, issuer and audience.",
   "flows": [
    "f6",
    "f7",
    "f8"
   ]
  },
  {
   "title": "Only what they may read",
   "caption": "The agent searches with the asker's groups. A passage outside those groups never leaves the store.",
   "flows": [
    "f9",
    "f10",
    "f11",
    "f12"
   ]
  },
  {
   "title": "Compose, then verify",
   "caption": "The model writes sentences that each point at a passage. A sentence its passage does not support is dropped.",
   "flows": [
    "f13"
   ],
   "focus": [
    "screen"
   ]
  },
  {
   "title": "A cited answer",
   "caption": "Every sentence ends with its source, and every reply carries a request id for the log.",
   "flows": [
    "f14",
    "f15"
   ]
  }
 ]
}
