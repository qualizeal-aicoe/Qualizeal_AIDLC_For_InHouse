  },
  {
   "id": "f2",
   "from": "github",
   "to": "ingest",
   "label": "files, issues (token)"
  },
  {
   "id": "f3",
   "from": "ingest",
   "to": "screen",
   "label": "every passage"
  },
  {
   "id": "f4",
   "from": "ingest",
   "to": "store",
   "label": "passages + who may read"
  },
  {
   "id": "f5",
   "from": "ingest",
   "to": "vectors",
   "label": "embeddings"
  },
  {
   "id": "f6",
   "from": "user",
   "to": "page",
   "label": "question"
  },
  {
   "id": "f7",
   "from": "page",
   "to": "gw",
