# The model gateway's environment, by name only. Copy this file to gateway/.env (ignored by git) and fill it in there.
# These belong to the gateway: the agent never sees a provider key, and refuses to start if one is in its environment.

# The gateway's own key: the agent sends it, the gateway checks it. Make it long and random.
LITELLM_MASTER_KEY=

# The providers in gateway/litellm.yaml
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# The open-weight fallback model through Ollama on this machine, e.g. http://host.docker.internal:11434
# OLLAMA_API_BASE=

# Langfuse (cloud or self-hosted): the gateway sends one record per model call, the agent its run traces.
# LANGFUSE_AUTH is the base64 of "public key:secret key", for the agent's OpenTelemetry export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_AUTH=
# LANGFUSE_HOST=
