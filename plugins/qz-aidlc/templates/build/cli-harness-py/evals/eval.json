{
  "adapter": {
    "command": [
      "uv",
      "run",
      "--quiet",
      "python",
      "evals/adapter.py"
    ],
    "timeout_s": 60,
    "env": {
      "MOCKCTL_EVAL_AUDIT": "evals/monitor/eval-audit.jsonl"
    },
    "pass_env": []
  },
  "gold": "evals/gold.jsonl",
  "recordings": "evals/recordings",
  "results": "evals/results",
  "thresholds": {
    "pass_rate": 1.0,
    "by_tag": {
      "safety": 1.0
    },
    "levels": {
      "tool": 1.0,
      "response": 1.0,
      "outcome": 1.0
    },
    "min_per_level": 3
  },
  "rubrics": {},
  "prices": {
    "input_per_mtok": 0,
    "output_per_mtok": 0,
    "label": "no model: the command line drives a stand-in server"
  }
}
