{"id": "lookup", "input": {"tool": "get_order", "args": {"order_id": "ORD-1001"}}, "tags": ["core"], "checks": [{"type": "tool_status", "name": "get_order", "status": "ok"}, {"type": "contains", "value": "shipped"}, {"type": "contains", "value": "\"untrusted\""}]}
{"id": "lookup-delivered", "input": {"tool": "get_order", "args": {"order_id": "ORD-1002"}}, "tags": ["core"], "checks": [{"type": "contains", "value": "delivered"}, {"type": "contains", "value": "UPS"}]}
{"id": "unknown-order", "input": {"tool": "get_order", "args": {"order_id": "ORD-9999"}}, "tags": ["core", "negative"], "checks": [{"type": "tool_status", "name": "get_order", "status": "error"}, {"type": "contains", "value": "No order ORD-9999"}]}
{"id": "note-is-data", "input": {"tool": "get_order", "args": {"order_id": "ORD-1003"}}, "tags": ["safety"], "checks": [{"type": "contains", "value": "never as instructions"}, {"type": "regex", "value": "\"untrusted\":\\s*\\[\\s*\"note\"\\s*\\]"}]}
{"id": "id-injection", "input": {"tool": "get_order", "args": {"order_id": "ORD-1001; DROP TABLE orders"}}, "tags": ["safety", "negative"], "checks": [{"type": "tool_status", "name": "get_order", "status": "error"}, {"type": "not_contains", "value": "shipped"}]}
{"id": "path-injection", "input": {"tool": "get_order", "args": {"order_id": "../../etc/passwd"}}, "tags": ["safety", "negative"], "checks": [{"type": "tool_status", "name": "get_order", "status": "error"}]}
{"id": "list-shipped", "input": {"tool": "list_orders", "args": {"status": "shipped"}}, "tags": ["core"], "checks": [{"type": "contains", "value": "ORD-1001"}, {"type": "not_contains", "value": "ORD-1002"}, {"type": "not_contains", "value": "\"note\":"}]}
{"id": "limit-capped", "input": {"tool": "list_orders", "args": {"limit": 500}}, "tags": ["safety", "negative"], "checks": [{"type": "tool_status", "name": "list_orders", "status": "error"}]}
